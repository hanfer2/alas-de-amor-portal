# ================================================================
# Alas de Amor — Configuración del portal
# ================================================================
# Copia este archivo como .env.local y ajusta los valores
# ================================================================

# ---- Sitio ----
# Opcional: en Vercel se toma solo del dominio de producción (VERCEL_PROJECT_PRODUCTION_URL).
# Defínela solo si quieres forzar otra dirección.
# NEXT_PUBLIC_SITE_URL=https://alas-de-amor-portal.vercel.app

# ---- Contacto ----
NEXT_PUBLIC_CONTACT_PHONE=+57 304 3732955
NEXT_PUBLIC_CONTACT_WHATSAPP=573043732955
NEXT_PUBLIC_CONTACT_EMAIL=Lilo_rodas87@hotmail.com

# ---- Redes Sociales ----
NEXT_PUBLIC_SOCIAL_FACEBOOK=https://www.facebook.com/liliana.rodas.9615
NEXT_PUBLIC_SOCIAL_INSTAGRAM=https://instagram.com/alasde_de_amor_
# TikTok (nueva). Fallback documentado: perfil @lilianarodas155
NEXT_PUBLIC_SOCIAL_TIKTOK=https://www.tiktok.com/@lilianarodas155?lang=es-419
# Embeds del Blog (opcionales). Vacíos => el slot muestra la card de perfil (fallback)
NEXT_PUBLIC_SOCIAL_INSTAGRAM_POST=
NEXT_PUBLIC_SOCIAL_TIKTOK_VIDEO=

# ---- Negocio ----
NEXT_PUBLIC_BUSINESS_NAME=Alas de Amor
NEXT_PUBLIC_BUSINESS_COUNTRY=Colombia
NEXT_PUBLIC_BUSINESS_HOURS=Lunes a Sábado: 8:00 AM - 6:00 PM

# ---- Google Verification (opcional) ----
# NEXT_PUBLIC_GOOGLE_VERIFICATION=tu-codigo-de-verificacion

# ---- Generación de Imágenes IA (agente disenador) ----
# Proveedor: replicate | huggingface | openai | custom
# IMAGE_API_PROVIDER=replicate
# IMAGE_API_KEY=r8_tu-api-key-de-replicate
# Modelo por defecto según proveedor:
#   replicate:       black-forest-labs/flux-schnell
#   huggingface:     stabilityai/stable-diffusion-xl-base-1.0
#   openai:          dall-e-3
#   custom:          qwen-3.8 (configurable vía IMAGE_MODEL)
# IMAGE_MODEL=black-forest-labs/flux-schnell
# IMAGE_API_URL=https://api.replicate.com/v1/models/{model}/predictions
# IMAGE_API_TIMEOUT=120000

# ---- Correo de los formularios (contacto y agendar cita) ----
# Opción recomendada y gratuita: Resend (3.000 correos al mes, 100 al día). Guía: docs/CORREO-GRATIS.md
# La API key es SECRETA: se define solo en Vercel (Settings > Environment Variables) o en .env.local,
# nunca en el repositorio (es público).
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# Sin dominio propio, Resend solo envía desde onboarding@resend.dev y solo a la dirección de tu cuenta de Resend.
# Con un dominio verificado: RESEND_FROM="Alas de Amor <citas@tudominio.com>"
# RESEND_FROM=Alas de Amor <onboarding@resend.dev>
# Dirección que recibe los mensajes (por defecto NEXT_PUBLIC_CONTACT_EMAIL).
# CONTACT_EMAIL=Lilo_rodas87@hotmail.com
# Alternativa: un webhook (por ejemplo Formspree, plan gratuito de 50 envíos al mes).
# EMAIL_WEBHOOK_URL=https://formspree.io/f/tu-id
# Sin ninguna de las dos, el formulario de contacto avisa que el correo no está disponible y remite a WhatsApp.

# ---- Precios en USD y EUR (opcional) ----
# Tasas de respaldo (1 COP en USD / EUR) si falla la consulta del día.
# NEXT_PUBLIC_DEFAULT_USD_RATE=0.00025
# NEXT_PUBLIC_DEFAULT_EUR_RATE=0.00023

# ---- Supabase (Base de Datos + Auth + Storage - FUTURO) ----
# Ver PENDING.md para instrucciones completas
# NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...     <-- NUNCA exponer en cliente
