# ---- Google Verification (opcional) ----
# NEXT_PUBLIC_GOOGLE_VERIFICATION=tu-codigo-de-verificacion

# ---- Generación de Imágenes IA (agente disenador) ----
# Proveedor: replicate | huggingface | openai | custom
# IMAGE_API_PROVIDER=replicate
# IMAGE_API_KEY=r8_tu-api-key-de-replicate
# Modelo por defecto según proveedor:
#   replicate:       black-forest-labs/flux-schnell
#   huggingface:     stabilityai/stable-diffusion-xl-base-1.0
#   openai:          dall-e-3
#   custom:          qwen-3.8 (configurable vía IMAGE_MODEL)
# IMAGE_MODEL=black-forest-labs/flux-schnell
# IMAGE_API_URL=https://api.replicate.com/v1/models/{model}/predictions
# IMAGE_API_TIMEOUT=120000

# ---- Email Webhook (opcional - para formularios) ----
# Agrega la URL de tu servicio de email (Formspree, Zapier, Make, n8n, etc.)
# EMAIL_WEBHOOK_URL=https://formspree.io/f/tu-id

# ---- Supabase (Base de Datos + Auth + Storage - FUTURO) ----
